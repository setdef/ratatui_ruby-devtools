#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Kerrick Long <me@kerricklong.com>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail
IFS=$'\n\t'
set -vx

if command -v mise >/dev/null 2>&1; then
  mise install
  mise x -- pip install reuse
  # A gem in the per-user gem directory may have been built for another Ruby,
  # so install the bundle inside the repo instead.
  mise x -- bundle config set --local path vendor/bundle
  mise x -- bundle install
  pre-commit install
else
  echo "mise isn't installed. Please install it to continue." >&2
  exit 1
fi
