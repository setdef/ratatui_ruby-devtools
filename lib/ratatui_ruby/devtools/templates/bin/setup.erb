#!/usr/bin/env bash
<%# REUSE-IgnoreStart -%>
# SPDX-FileCopyrightText: <%= Time.now.year %> <%= copyright_holder %>
# SPDX-License-Identifier: <%= license %>
<%# REUSE-IgnoreEnd -%>

set -euo pipefail
IFS=$'\n\t'
set -vx

if ! command -v mise >/dev/null 2>&1; then
  echo "mise isn't installed. Please install it to continue." >&2
  exit 1
fi

mise install
<%- if has_rust -%>
mise x -- rustup component add rustfmt clippy
<%- end -%>
mise x -- pip install 'reuse[charset-normalizer]'
mise x -- gem install bundler:4.0.3

# A gem in the per-user gem directory may have been built for another Ruby,
# so install the bundle inside the repo instead.
mise x -- bundle config set --local path vendor/bundle

if [ "${CI:-}" = "true" ]; then
  bundle config set --local frozen 'true'
fi

mise x -- bundle install

if [ "${CI:-}" != "true" ]; then
  pre-commit install
<%- if has_rdoc -%>
  bundle exec rake rdoc
<%- end -%>
fi
