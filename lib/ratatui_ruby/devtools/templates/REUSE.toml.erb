<%# REUSE-IgnoreStart -%>
# SPDX-FileCopyrightText: <%= Time.now.year %> <%= copyright_holder %>
# SPDX-License-Identifier: <%= license %>
<%# REUSE-IgnoreEnd -%>

version = 1

[[annotations]]
path = 'Gemfile.lock'
SPDX-FileCopyrightText = "<%= Time.now.year %> <%= copyright_holder %>"
SPDX-License-Identifier = "CC0-1.0"
<%- if has_rust -%>

[[annotations]]
path = 'ext/<%= gem_name %>/Cargo.lock'
SPDX-FileCopyrightText = "<%= Time.now.year %> <%= copyright_holder %>"
SPDX-License-Identifier = "CC0-1.0"
<%- end -%>

[[annotations]]
path = '**/snapshots/*.txt'
SPDX-FileCopyrightText = "<%= Time.now.year %> <%= copyright_holder %>"
SPDX-License-Identifier = "<%= license %>"

[[annotations]]
path = '**/snapshots/*.ansi'
SPDX-FileCopyrightText = "<%= Time.now.year %> <%= copyright_holder %>"
SPDX-License-Identifier = "<%= license %>"

[[annotations]]
path = 'doc/images/*'
SPDX-FileCopyrightText = "<%= Time.now.year %> <%= copyright_holder %>"
SPDX-License-Identifier = "CC-BY-SA-4.0"
